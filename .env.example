PBP_EMAIL=you@example.com
PBP_PASSWORD=your-password

# After copying booking.config.example.json → booking.config.json:
# BOOKING_CONFIG=./booking.config.json

# Web log UI port (http://nas-ip:8888)
# DOZZLE_PORT=8888

# Optional: base64 Playwright storage from `npm run export-session` on your Mac
# PBP_STORAGE_STATE=

# Optional plain-text ping when a slot is found or booked (e.g. ntfy.sh topic URL)
# NOTIFY_WEBHOOK=https://ntfy.sh/your-topic
